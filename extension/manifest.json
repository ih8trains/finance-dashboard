{
  "manifest_version": 3,
  "name": "T-Bank Auto Sync",
  "version": "4.0.6",
  "description": "Read-only синхронизация операций Т-Банка с зашифрованными архивами GitHub",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.tbank.ru/*",
    "*://*.tbank-online.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "T-Bank Auto Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}